generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  fullName    String
  email       String    @unique
  phone       String    @unique
  password    String
  role        UserRole  @default(USER)
  lastLoginAt DateTime?

  failedLoginAttempts Int @default(0)

  accountLockedUntil DateTime?

  passwordChangedAt DateTime?

  lastPasswordResetAt DateTime?

  gender       Gender?
  profileImage String?

  isVerified               Boolean   @default(false)
  isActive                 Boolean   @default(true)
  isBlocked                Boolean   @default(false)
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  passwordResetToken   String?
  passwordResetExpires DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver         Driver?
  rides          Ride[]
  payments       Payment[]
  couponsCreated Coupon[]
  couponUsages   CouponUsage[]
  rideReviews    RideReview[]
  Notification   Notification[]

  adminSessions     AdminSession[]
  adminLoginHistory AdminLoginHistory[]
  auditLogs         AuditLog[]

  @@index([isBlocked])
  @@index([deletedAt])
}

model Driver {
  id String @id @default(cuid())

  userId String @unique

  licenseNumber String @unique
  aadharNumber  String @unique

  status       DriverStatus       @default(PENDING)
  availability DriverAvailability @default(OFFLINE)

  experience Int

  averageRating Float @default(0)
  totalRatings  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rides       Ride[]
  rideRejects RideReject[]
  rideReviews RideReview[]

  vehicle Vehicle?

  documents DriverDocument[]
  wallet    DriverWallet?

  @@index([status])
  @@index([availability])
}

model Vehicle {
  id String @id @default(cuid())

  driverId String @unique

  vehicleType VehicleType
  category    VehicleCategory
  status      VehicleStatus   @default(PENDING)
  rejectionReason String?

  brand String
  model String
  color String

  vehicleNumber String @unique

  seats Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  documents VehicleDocument[]

  @@index([vehicleType])
  @@index([category])
  @@index([status])
}

model Ride {
  id String @id @default(cuid())

  userId   String
  driverId String?

  pickup      String
  destination String

  pickupLatitude  Float?
  pickupLongitude Float?

  destinationLatitude  Float?
  destinationLongitude Float?

  distance Float
  duration Float?

  routeGeometry Json?
  fareBreakdown Json?

  vehicleType VehicleType

  status RideStatus @default(REQUESTED)

  isScheduled  Boolean   @default(false)
  scheduledFor DateTime?

  baseFare     Decimal @default(0) @db.Decimal(10, 2)
  distanceFare Decimal @default(0) @db.Decimal(10, 2)
  durationFare Decimal @default(0) @db.Decimal(10, 2)

  bookingFee  Decimal @default(0) @db.Decimal(10, 2)
  platformFee Decimal @default(0) @db.Decimal(10, 2)

  surgeAmount     Decimal @default(0) @db.Decimal(10, 2)
  surgeMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  airportCharge Decimal @default(0) @db.Decimal(10, 2)
  tollCharge    Decimal @default(0) @db.Decimal(10, 2)
  waitingCharge Decimal @default(0) @db.Decimal(10, 2)

  gstAmount Decimal @default(0) @db.Decimal(10, 2)

  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  estimatedFare  Decimal  @default(0) @db.Decimal(10, 2)
  finalFare      Decimal? @db.Decimal(10, 2)

  couponId String?

  estimatedArrival DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  payment Payment?

  rideRejects RideReject[]

  rideReview RideReview?

  couponUsage CouponUsage?

  fareAudit FareAudit?

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([vehicleType])
  @@index([couponId])
  @@index([createdAt])
}

model RideReject {
  id String @id @default(cuid())

  rideId   String
  driverId String

  createdAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverId])
  @@index([rideId])
  @@index([driverId])
}

model RideReview {
  id String @id @default(cuid())

  rideId String @unique

  userId String

  driverId String

  rating Int

  review String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([userId])
  @@index([createdAt])
}

model Payment {
  id String @id @default(cuid())

  rideId String @unique

  userId String

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod

  status PaymentStatus @default(PENDING)

  gateway String?

  transactionId String? @unique

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Coupon {
  id String @id @default(cuid())

  code String @unique

  description String?

  type CouponType

  discountValue Decimal @db.Decimal(10, 2)

  minimumRideFare Decimal @default(0) @db.Decimal(10, 2)

  maximumDiscount Decimal? @db.Decimal(10, 2)

  usageLimit Int?

  perUserUsageLimit Int @default(1)

  usedCount Int @default(0)

  validFrom DateTime

  validUntil DateTime

  isActive Boolean @default(true)

  createdById String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  couponUsages CouponUsage[]

  rides Ride[]

  @@index([code])
  @@index([createdById])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

model CouponUsage {
  id String @id @default(cuid())

  couponId String

  userId String

  rideId String @unique

  discountAmount Decimal @db.Decimal(10, 2)

  usedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, rideId])
  @@index([couponId])
  @@index([userId])
  @@index([usedAt])
}

model PricingConfig {
  id String @id @default(cuid())

  city String @default("DEFAULT")

  vehicleType VehicleType

  baseFare Decimal @db.Decimal(10, 2)

  pricePerKm Decimal @db.Decimal(10, 2)

  pricePerMinute Decimal @db.Decimal(10, 2)

  minimumFare Decimal @db.Decimal(10, 2)

  platformFee Decimal @db.Decimal(10, 2)

  bookingFee Decimal @db.Decimal(10, 2)

  gstPercentage Decimal @db.Decimal(5, 2)

  waitingChargePerMinute Decimal @db.Decimal(10, 2)

  airportCharge Decimal @db.Decimal(10, 2)

  peakMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  nightMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  rainMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  eventMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  maxSurgeMultiplier Decimal @default(3.00) @db.Decimal(4, 2)

  currency Currency @default(INR)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([city, vehicleType])
  @@index([isActive])
  @@index([vehicleType])
}

model FareAudit {
  id String @id @default(cuid())

  rideId String @unique

  pricingConfigId String?

  baseFare     Decimal @db.Decimal(10, 2)
  distanceFare Decimal @db.Decimal(10, 2)
  durationFare Decimal @db.Decimal(10, 2)

  surgeAmount    Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  platformFee    Decimal @db.Decimal(10, 2)

  finalFare Decimal @db.Decimal(10, 2)

  breakdown Json

  createdAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId String

  title String

  message String

  type NotificationType

  channel NotificationChannel @default(IN_APP)

  status NotificationStatus @default(PENDING)

  priority NotificationPriority @default(NORMAL)

  metadata Json?

  readAt DateTime?

  sentAt DateTime?

  failedAt DateTime?

  retryCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([createdAt])
}

model AdminSession {
  id String @id @default(cuid())

  userId String

  refreshTokenHash String @unique

  ipAddress String?

  userAgent String?

  deviceName String?

  isRevoked Boolean @default(false)

  expiresAt DateTime

  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRevoked])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model AdminLoginHistory {
  id String @id @default(cuid())

  userId String?

  email String

  ipAddress String?

  userAgent String?

  status LoginStatus

  failureReason String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  adminId String

  action AuditAction

  entity AuditEntity

  entityId String?

  metadata Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model DriverDocument {
  id String @id @default(cuid())

  driverId String

  documentType   DriverDocumentType
  documentNumber String?

  fileUrl      String
  filePublicId String?

  status DriverDocumentStatus @default(PENDING)

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, documentType])
  @@index([driverId])
  @@index([documentType])
  @@index([status])
  @@index([createdAt])
}

model DriverWallet {
  id String @id @default(cuid())

  driverId String @unique

  balance        Decimal @default(0) @db.Decimal(12, 2)
  totalEarnings  Decimal @default(0) @db.Decimal(12, 2)
  totalWithdrawn Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  transactions DriverWalletTransaction[]

  @@index([driverId])
}

model DriverWalletTransaction {
  id String @id @default(cuid())

  walletId String

  type   DriverWalletTransactionType
  status DriverWalletTransactionStatus @default(COMPLETED)

  amount Decimal @db.Decimal(12, 2)

  referenceType String?
  referenceId   String?

  description String?

  createdAt DateTime @default(now())

  wallet DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([referenceId])
  @@index([createdAt])
}

enum UserRole {
  USER
  DRIVER

  SUPER_ADMIN
  ADMIN

  OPERATIONS_MANAGER
  FINANCE_MANAGER
  SUPPORT_EXECUTIVE
  DRIVER_MANAGER
  MARKETING_MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  BIKE
  AUTO
  CAR
  SUV
}

enum VehicleCategory {
  ECONOMY
  PREMIUM
  LUXURY
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DriverAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  WALLET
}

enum CouponType {
  FLAT
  PERCENTAGE
}

enum Currency {
  INR
}

enum NotificationType {
  SYSTEM
  ACCOUNT
  SECURITY
  RIDE
  PAYMENT
  PROMOTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  READ
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LoginStatus {
  SUCCESS
  FAILED
  LOCKED
  LOGOUT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SUSPEND
  BLOCK
  ACTIVATE
  CANCEL
  REFUND
}

enum AuditEntity {
  ADMIN

  USER
  DRIVER
  VEHICLE
  RIDE
  PAYMENT
  COUPON
  PRICING
  NOTIFICATION
  SETTINGS
}

enum DriverDocumentType {
  LICENSE
  AADHAAR
  RC
  INSURANCE
  PERMIT
  FITNESS
}

enum DriverDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DriverWalletTransactionType {
  CREDIT
  DEBIT
}

enum DriverWalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model VehicleDocument {
  id String @id @default(cuid())

  vehicleId String

  documentType   VehicleDocumentType
  documentNumber String?

  fileUrl      String
  filePublicId String?

  status          VehicleDocumentStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, documentType])
  @@index([vehicleId])
  @@index([documentType])
  @@index([status])
}

enum VehicleDocumentType {
  RC
  INSURANCE
  PERMIT
  FITNESS
}

enum VehicleDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}
