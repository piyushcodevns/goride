PORT=

DATABASE_URL=

JWT_SECRET=
JWT_ISSUER=goride
JWT_AUDIENCE=goride-api
JWT_EXPIRES_IN=
ADMIN_2FA_ENCRYPTION_KEY=

EMAIL_HOST=

EMAIL_PORT=

EMAIL_USER=

EMAIL_PASS=

EMAIL_FROM=
# Backup
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_SIZE_MB=2048
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_RESTORE_PATH=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
BACKUP_SCHEDULE_ENABLED=false
BACKUP_CRON=0 2 * * *

# Background Jobs & Queues (Redis / BullMQ)
REDIS_URL=redis://127.0.0.1:6379
QUEUE_ENABLED=true
SCHEDULED_RIDES_SCHEDULE_ENABLED=true
CLEANUP_SCHEDULE_ENABLED=true
WORKER_CONCURRENCY=5

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability & Monitoring
LOG_LEVEL=info
LOG_FORMAT=combined
