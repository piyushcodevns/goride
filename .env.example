# ============================================================================
# GoRide Environment Configuration Template
# All secrets should be populated with safe, environment-specific values.
# Do NOT commit actual production credentials or keys to source control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Application & Server
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ----------------------------------------------------------------------------
# 2. Database (PostgreSQL / Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:root@localhost:5432/goride_db

# ----------------------------------------------------------------------------
# 3. Authentication & Security (JWT & Admin 2FA)
# ----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_min
JWT_ISSUER=goride
JWT_AUDIENCE=goride-api
JWT_EXPIRES_IN=7d
ADMIN_2FA_ENCRYPTION_KEY=your_admin_totp_aes256_encryption_key_32c
BCRYPT_SALT_ROUNDS=12

# ----------------------------------------------------------------------------
# 4. Redis & Background Queues (BullMQ)
# ----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
QUEUE_ENABLED=true
NOTIFICATION_QUEUE_ENABLED=true
WORKER_CONCURRENCY=5
SCHEDULED_RIDE_CONCURRENCY=5
DATASET_CONCURRENCY=5

# ----------------------------------------------------------------------------
# 5. Background Schedulers
# ----------------------------------------------------------------------------
SCHEDULED_RIDES_SCHEDULE_ENABLED=true
SCHEDULED_RIDES_CRON=* * * * *
CLEANUP_SCHEDULE_ENABLED=true
CLEANUP_CRON=0 3 * * *
BACKUP_SCHEDULE_ENABLED=false
BACKUP_CRON=0 2 * * *

# ----------------------------------------------------------------------------
# 6. Maps & Routing (OpenRouteService)
# ----------------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
MAPS_REQUEST_TIMEOUT_MS=10000
MAPS_MAX_RETRIES=2
MAPS_CACHE_TTL=300
MAPS_RATE_LIMIT_BUFFER=5

# ----------------------------------------------------------------------------
# 7. Cloudinary Media Storage
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------------------------------------------------------------------
# 8. Email & SMTP Notifications
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=GoRide <noreply@goride.com>

# ----------------------------------------------------------------------------
# 9. Observability & Monitoring
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=combined

# ----------------------------------------------------------------------------
# 10. CORS & Swagger
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false

# ----------------------------------------------------------------------------
# 11. Database Backup System
# ----------------------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_SIZE_MB=2048
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# ----------------------------------------------------------------------------
# 12. Caching & In-Memory Performance
# ----------------------------------------------------------------------------
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=5000
ANALYTICS_CACHE_TTL_MS=300000

# ----------------------------------------------------------------------------
# 13. Google Gemini AI Assistant
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
